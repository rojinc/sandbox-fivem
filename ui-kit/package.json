{
  "name": "@sandbox/ui-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Svelte design system (GOLD / Australian Government Design System look, Roboto) and NUI runtime for every SandboxRP interface.",
  "svelte": "./src/index.js",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "svelte": "./src/index.js",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./vite": "./vite.js",
    "./nui": "./src/nui.js",
    "./icons": "./src/icons.js",
    "./fonts": "./src/fonts.js",
    "./sanitize": "./src/sanitize.js",
    "./util": "./src/util.js",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components/*": "./src/components/*"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "dompurify": "^3.4.17",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  }
}
