{
  "name": "sandbox-fivem",
  "private": true,
  "description": "SandboxRP FiveM server: resources plus the NUI (Svelte) front-ends, built from one workspace.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "ui-kit",
    "ui-kit/example"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "preview": "node scripts/preview.mjs",
    "clean": "node scripts/build-all.mjs --clean",
    "luacheck": "python3 -I scripts/luacheck.py server/resources",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
